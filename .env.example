# ===================== 大语言模型 =====================
# LLM_PROVIDER: "deepseek" 或 "qwen"
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=

# ===================== 向量库 ChromaDB =====================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./chroma_data
COLLECTION_NAME=RAG

# ===================== 嵌入模型 =====================
EMBEDDING_MODEL_NAME=

# ===================== 企业微信 =====================
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_CORP_ID=

# ===================== 飞书通用配置 =====================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# 收集信息任务通知人 user_id
FEISHU_ASSIGNEE_ID=
# 通知群 chat_id（oc_ 开头）
FEISHU_GROUP_CHAT_ID=
COLLECT_INFO_INTERVAL=3600

# 备案任务
FILING_ASSIGNEE_IDS=
FILING_TOKEN=
FILING_TABLE_ID=

# ===================== 支付库（订单排查用） =====================
PAYMENT_DB_HOST=
PAYMENT_DB_PORT=
PAYMENT_DB_USER=
PAYMENT_DB_PASSWORD=
PAYMENT_DB_NAME=

# ===================== 群间消息转发（已有能力） =====================
MSG_TRANSFER_FEISHU_APP_ID=
MSG_TRANSFER_FEISHU_APP_SECRET=
MSG_TRANSFER_SOURCE_CHAT_ID=
MSG_TRANSFER_TARGET_CHAT_ID=
MSG_TRANSFER_KEYWORDS=
MSG_TRANSFER_MENTION_USER_IDS=
MSG_TRANSFER_POLL_INTERVAL=5

# ===================== FAQ 关键词告警（本次新增） =====================
# 咨询走 /api/v1/chat 时，命中关键词即推送飞书群 + 写多维表格。
# 以下凭证/群/表格若不单独配置，会自动回退复用上面的 FEISHU_* 配置。
FAQ_ALERT_ENABLED=true
# 预置关键词，逗号分隔（运行时还可通过 /api/v1/faq-alert/keywords 动态增删）
FAQ_ALERT_KEYWORDS=
# 推送目标群 chat_id（缺省回退 FEISHU_GROUP_CHAT_ID）
FAQ_ALERT_TARGET_CHAT_ID=
# @ 的人员 user_id，逗号分隔，可为空
FAQ_ALERT_MENTION_USER_IDS=
# 告警专用飞书应用（缺省回退 FEISHU_APP_ID/SECRET）
FAQ_ALERT_FEISHU_APP_ID=
FAQ_ALERT_FEISHU_APP_SECRET=
# 记录写入的多维表格（缺省回退 FEISHU_BITABLE_APP_TOKEN/TABLE_ID）
FAQ_ALERT_BITABLE_APP_TOKEN=
FAQ_ALERT_BITABLE_TABLE_ID=
# 多维表格列名（需与飞书表格实际列名一致）
FAQ_ALERT_FIELD_QUESTION=问题
FAQ_ALERT_FIELD_ANSWER=回答
FAQ_ALERT_FIELD_KEYWORD=命中关键词
FAQ_ALERT_FIELD_TIME=时间
# 同一关键词去重窗口（秒），0 表示不去重
FAQ_ALERT_DEDUP_WINDOW=0
